#!/usr/bin/env bash
# mmm — canonical wiki store, symlinked into each project's .omc/wiki. See ~/mmm/README.md.
set -euo pipefail

MMM_HOME="${MMM_HOME:-$HOME/.mmm}"  # private data. ~/mmm (no dot) is the tool itself — bin/, README, .git
MMM_SELF="${BASH_SOURCE[0]}"
[ -L "$MMM_SELF" ] && MMM_SELF="$(readlink "$MMM_SELF")"  # one hop is all we ever create
MMM_BIN="$(cd "$(dirname "$MMM_SELF")" && pwd)"
REGISTRY="$MMM_HOME/registry.json"

die() { echo "mmm: $*" >&2; exit 1; }

# AWS, GitHub, Anthropic/OpenAI, Slack, Google, GitLab keys, PEM private keys, JWTs -- formats
# with a fixed prefix, so a match is almost never prose (unlike the keyword grep in doctor)
SECRET_SHAPES='\bAKIA[0-9A-Z]{16}\b|\bgh[pousr]_[A-Za-z0-9]{36,}|\bgithub_pat_[A-Za-z0-9_]{22,}|\bsk-(ant-|proj-)?[A-Za-z0-9_-]{20,}|\bxox[abprs]-[A-Za-z0-9-]{10,}|\bAIza[0-9A-Za-z_-]{35}|\bglpat-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'

# command -> Homebrew formula, only where they diverge from the command name itself (rg ships
# in "ripgrep"; the "7z" binary ships in "p7zip", not the newer "sevenzip" formula's "7zz";
# claude is a cask, not a formula). A case, not `declare -A`: macOS still ships bash 3.2.
dep_formula() {
  case "$1" in
    rg) echo ripgrep ;;
    7z) echo p7zip ;;
    claude) echo "--cask claude-code" ;;
    *) echo "$1" ;;
  esac
}
need() {
  local dep
  for dep in "$@"; do
    command -v "$dep" >/dev/null 2>&1 && continue
    die "requires '$dep' on PATH — install it with: brew install $(dep_formula "$dep")"
  done
}
# only what runs before dispatch is needed globally; each subcommand checks the rest itself, so
# a missing rsync (init only) or 7z (pack only) never blocks 'mmm q' or 'mmm status'
need python3

# self-heals on a fresh machine — nothing else bootstraps ~/.mmm before the first real command
if [ ! -f "$REGISTRY" ]; then
  mkdir -p "$MMM_HOME"
  printf '{\n  "searchRoots": [],\n  "projects": {}\n}\n' > "$REGISTRY"
  echo "mmm: first run — created $REGISTRY (empty; add your own dirs to searchRoots if you want auto-rediscovery)"
fi

# ~/.mmm is its own local git repo (never pushed anywhere): history and undo for pages an agent
# rewrote, and a restore point before unpack lays an archive over the store. Fixed identity so
# a machine with no git user configured still commits.
store_git() { git -C "$MMM_HOME" -c user.name=mmm -c user.email=mmm@localhost "$@"; }
snapshot() {
  [ -d "$MMM_HOME/.git" ] && command -v git >/dev/null 2>&1 || return 0
  store_git add -A
  store_git diff --cached --quiet || store_git commit -q -m "$1"
}
# git is checked per-subcommand like everything else, so no git here just means no history yet
if [ ! -d "$MMM_HOME/.git" ] && command -v git >/dev/null 2>&1; then
  git init -q "$MMM_HOME"
  snapshot "mmm: start history"
  echo "mmm: $MMM_HOME is now a local git repo (history only, no remote) — see 'mmm git log'"
fi

realpath_of() { python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$1"; }
expand_tilde() { printf '%s' "${1/#\~/$HOME}"; }

# mktemp/EnterWorktree-style checkouts live here — never worth a permanent registry entry
TMPROOT="$(realpath_of "${TMPDIR:-/tmp}")"
is_under_tmp() { case "$(realpath_of "$1")" in "$TMPROOT"/*) return 0 ;; *) return 1 ;; esac; }

# .git/info/exclude lives in the shared common dir, not per-worktree — `$root/.git` is a plain
# FILE (a `gitdir: ...` pointer), not a directory, inside a `git worktree add` checkout.
git_exclude_path() {
  local root="$1" common
  common=$(git -C "$root" rev-parse --git-common-dir)
  [[ "$common" = /* ]] || common="$root/$common"
  printf '%s/info/exclude' "$common"
}

# anchored to the root so a nested CLAUDE.md (e.g. a monorepo subpackage's own) stays visible
ensure_ignored() {
  local root="$1" path="$2"
  git -C "$root" check-ignore -q "$path" 2>/dev/null && return 0
  echo "/$path" >> "$(git_exclude_path "$root")"
  git -C "$root" check-ignore -q "$path"
}

# --- registry-backed project path resolution ---------------------------------
resolve_path() {
  local key="$1" remote hint origin
  remote=$(jq -r --arg k "$key" '.projects[$k].remote // empty' "$REGISTRY")
  [ -n "$remote" ] || return 1
  hint=$(jq -r --arg k "$key" '.projects[$k].pathHint // empty' "$REGISTRY")
  hint=$(expand_tilde "$hint")
  if [ -n "$hint" ] && git -C "$hint" rev-parse --git-dir >/dev/null 2>&1; then
    origin=$(git -C "$hint" remote get-url origin 2>/dev/null || true)
    if [ "$origin" = "$remote" ]; then echo "$hint"; return 0; fi
  fi
  local root
  while IFS= read -r root; do
    root=$(expand_tilde "$root")
    [ -d "$root" ] || continue
    local gitdir repo
    while IFS= read -r gitdir; do
      repo="${gitdir%/.git}"
      origin=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
      if [ "$origin" = "$remote" ]; then echo "$repo"; return 0; fi
    done < <(find "$root" -maxdepth 5 -type d -name .git 2>/dev/null)
  done < <(jq -r '.searchRoots[]' "$REGISTRY")
  return 1
}

# --- status --------------------------------------------------------------
# STATUS_ISSUES counts DANGLING/UNEXPECTED links across a cmd_status run -- 'mmm status' itself
# stays a plain report (no exit-code change), but cmd_doctor reads this after calling cmd_status
# so a broken store fails doctor instead of printing a warning and shipping anyway.
STATUS_ISSUES=0

status_one() {
  local key="$1" wiki="$2" store="$3"
  if [ -L "$wiki" ]; then
    if [ -e "$wiki" ]; then
      if [ "$(realpath_of "$wiki")" = "$(realpath_of "$store")" ]; then
        echo "  $key: linked ✓  ($wiki -> $store)"
      else
        echo "  $key: linked to UNEXPECTED target ($wiki -> $(readlink "$wiki"))"
        STATUS_ISSUES=$((STATUS_ISSUES + 1))
      fi
    else
      echo "  $key: DANGLING symlink ($wiki -> $(readlink "$wiki") — target missing)"
      STATUS_ISSUES=$((STATUS_ISSUES + 1))
    fi
  elif [ -d "$wiki" ]; then
    echo "  $key: not yet initialized (real directory at $wiki)"
  else
    echo "  $key: no wiki directory yet"
  fi
}

cmd_forget() {
  need jq
  local key="$1"
  jq -e --arg k "$key" '.projects[$k]' "$REGISTRY" >/dev/null 2>&1 || die "no such registered project: $key"
  local tmp; tmp=$(mktemp)
  jq --arg k "$key" 'del(.projects[$k])' "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"
  echo "mmm: forgot '$key' from the registry"
  if [ -d "$MMM_HOME/projects/$key" ]; then
    echo "mmm: NOTE — $MMM_HOME/projects/$key still has its data; delete it yourself if you don't want it"
  fi
}

cmd_status() {
  need jq git
  STATUS_ISSUES=0
  echo "global:"
  status_one "global" "$HOME/.omc/wiki" "$MMM_HOME/global"
  echo "projects:"
  local k path
  for k in $(jq -r '.projects | keys[]' "$REGISTRY"); do
    if path=$(resolve_path "$k"); then
      status_one "$k" "$path/.omc/wiki" "$MMM_HOME/projects/$k"
    else
      echo "  $k: absent on this machine (registered, not found)"
    fi
  done
}

# --- init ------------------------------------------------------------------
seed_index() {
  local proj_root="$1" store="$2" do_scan="$3" idx="$2/index.md" found=()
  local f
  [ -f "$idx" ] || { printf '# Wiki Index\n\n' > "$idx"; }
  [ "$do_scan" = 1 ] || return 0
  for f in README.md README.rst CLAUDE.md AGENTS.md; do
    [ -f "$proj_root/$f" ] && found+=("$f")
  done
  if [ "${#found[@]}" -gt 0 ] && ! grep -q '^## Existing project docs' "$idx" 2>/dev/null; then
    {
      printf '\n## Existing project docs\n\n'
      for f in "${found[@]}"; do printf -- '- `%s` at project root\n' "$f"; done
    } >> "$idx"
  fi
}

ensure_claude_md() {
  local root="$1" store="$2"
  [ -f "$root/CLAUDE.md" ] && return 0
  # a fresh checkout of an already-adopted project has its CLAUDE.md in the store, not in the repo
  [ -f "$store/CLAUDE.md" ] && return 0
  # unlike import/ask (whose whole job is talking to claude), init's /init seed is a bonus, not
  # its purpose -- a Cursor-only machine with no 'claude' CLI must still be able to init a project
  if ! command -v claude >/dev/null 2>&1; then
    echo "mmm: no CLAUDE.md in $root and no 'claude' CLI on PATH — skipping the /init seed (fine for a Cursor-only setup); add one yourself anytime"
    return 0
  fi
  echo "mmm: no CLAUDE.md in $root — running claude /init (non-interactive)"
  ( cd "$root" && claude -p "/init" )
}

# real file lives in the store, repo gets a git-ignored symlink; always returns 0 so one project never stops a rebalance or pack.
# AGENTS.md gets the same treatment when it's a personal file, but it's usually the team's shared,
# committed instructions for Codex/Copilot/Cursor -- a tracked or absent one is simply not ours.
link_claude_md() {
  local key="$1" root="$2" name="${3:-CLAUDE.md}"
  local repo_copy="$2/$name" store_copy="$MMM_HOME/projects/$1/$name"
  # a tracked file ignores exclude rules, and untracking it rewrites a shared repo -- never automatic
  if git -C "$root" ls-files --error-unmatch "$name" >/dev/null 2>&1; then
    [ "$name" = CLAUDE.md ] && echo "  $key: WARN CLAUDE.md is tracked by git — run 'git -C $root rm --cached CLAUDE.md', commit, then re-run 'mmm rebalance'"
    return 0
  fi
  if [ -L "$repo_copy" ]; then
    if [ "$(realpath_of "$repo_copy")" != "$(realpath_of "$store_copy")" ]; then
      echo "  $key: WARN $name is a symlink to $(readlink "$repo_copy"), not the store — left alone"
      return 0
    fi
  elif [ -f "$repo_copy" ]; then
    if [ ! -e "$store_copy" ]; then
      mkdir -p "$(dirname "$store_copy")"
      mv "$repo_copy" "$store_copy"
      echo "  $key: moved $name into $store_copy"
    elif cmp -s "$repo_copy" "$store_copy"; then
      rm "$repo_copy"
    else
      echo "  $key: WARN $name differs from $store_copy — compare them, keep one, then re-run 'mmm rebalance'"
      return 0
    fi
  fi
  if [ ! -f "$store_copy" ]; then
    [ "$name" = CLAUDE.md ] && echo "  $key: no CLAUDE.md"
    return 0
  fi
  # ignore before linking so the symlink is never visible as untracked, even briefly
  if ! ensure_ignored "$root" "$name"; then
    echo "  $key: WARN could not git-ignore $name in $root — left unlinked"
    return 0
  fi
  ln -sfn "$store_copy" "$repo_copy"
  echo "  $key: $name linked ✓"
}

# Claude Code's auto memory is machine-local by design (~/.claude/projects/<dir>/memory); moving
# it into the store is what lets it travel with pack. Same adopt-then-symlink move as init_one.
link_auto_memory() {
  local key="$1" root="$2" store="$MMM_HOME/projects/$1/memory" common main mem
  [ -d "$HOME/.claude" ] || return 0  # no Claude Code on this machine, nothing to adopt
  common=$(git -C "$root" rev-parse --git-common-dir 2>/dev/null) || return 0
  [[ "$common" = /* ]] || common="$root/$common"
  # Claude Code keys the dir by the main checkout, so every worktree shares one memory dir
  main=$(dirname "$(realpath_of "$common")")
  mem="$HOME/.claude/projects/$(printf '%s' "$main" | sed 's/[^A-Za-z0-9]/-/g')/memory"
  if [ -L "$mem" ]; then
    if [ "$(realpath_of "$mem")" = "$(realpath_of "$store")" ]; then
      echo "  $key: auto memory linked ✓"
    else
      echo "  $key: WARN auto memory $mem is a symlink to $(readlink "$mem"), not the store — left alone"
    fi
    return 0
  fi
  if [ -d "$mem" ]; then
    mkdir -p "$store"
    # another machine's memory may already be in the store: MEMORY.md especially will differ,
    # and picking one side silently drops the other's index
    local f clash=()
    for f in "$mem"/*; do
      [ -e "$f" ] || continue
      if [ -e "$store/$(basename "$f")" ] && ! cmp -s "$f" "$store/$(basename "$f")"; then
        clash+=("$(basename "$f")")
      fi
    done
    if [ "${#clash[@]}" -gt 0 ]; then
      echo "  $key: WARN auto memory in $mem and $store both have different: ${clash[*]} — merge them by hand, then re-run 'mmm rebalance'"
      return 0
    fi
    rsync -a "$mem"/ "$store"/
    rm -rf "$mem"
    echo "  $key: moved auto memory into $store"
  fi
  mkdir -p "$store" "$(dirname "$mem")"
  ln -s "$store" "$mem"
  echo "  $key: auto memory linked ✓"
}

init_one() {
  local key="$1" root="$2" wiki="$3" store="$4" seed="$5" force_merge="$6"
  if [ "$key" != "global" ]; then
    ensure_ignored "$root" .omc || die "could not confirm .omc is git-ignored in $root — refusing to init"
    [ "$seed" = 1 ] && ensure_claude_md "$root" "$store"
  fi
  if [ -L "$wiki" ] && [ -e "$wiki" ] && [ "$(realpath_of "$wiki")" = "$(realpath_of "$store")" ]; then
    echo "mmm: $key already initialized"
    return 0
  fi
  local first_time=0
  if [ ! -d "$store" ]; then mkdir -p "$store"; first_time=1; fi
  if [ -e "$wiki" ] && [ ! -L "$wiki" ]; then
    # a second worktree/clone of the same remote resolves to the same key/store on purpose
    # (one project, one wiki) — but if it independently grew real content, merging blind
    # would let same-named files silently clobber the first checkout's version.
    if [ "$first_time" != 1 ] && [ "$force_merge" != 1 ] \
        && find "$wiki" -mindepth 1 -print -quit 2>/dev/null | grep -q .; then
      die "'$key' is already initialized (from a different checkout) and $wiki has its own content — \
refusing to silently merge, same-named files would be overwritten. Compare $wiki against $store \
yourself, then re-run with 'mmm init $root --merge' if that's really what you want."
    fi
    rsync -a "$wiki"/ "$store"/
    rm -rf "$wiki"
    # raw move only — placement/frontmatter/size normalization is optional and separate,
    # not something init does for you
    echo "mmm: moved existing $wiki content into $store as-is — run 'mmm import $store' to normalize it (placement rule, frontmatter, page budget)"
  elif [ -L "$wiki" ]; then
    rm "$wiki"
  fi
  mkdir -p "$(dirname "$wiki")"
  ln -s "$store" "$wiki"
  if [ "$first_time" = 1 ]; then
    seed_index "$root" "$store" "$seed"
  fi
  echo "mmm: initialized $key -> $store (linked at $wiki)"
}

cmd_init() {
  need jq git rsync
  local target="$1" force_merge=0
  [ "${2:-}" = "--merge" ] && force_merge=1
  if [ "$target" = "--global" ]; then
    init_one "global" "$HOME/.omc" "$HOME/.omc/wiki" "$MMM_HOME/global" 0 "$force_merge"
    return
  fi
  local path origin key
  path=$(cd "$target" && pwd)
  origin=$(git -C "$path" remote get-url origin 2>/dev/null) || die "not a git repo with an origin remote: $path"
  key=$(jq -r --arg r "$origin" '.projects | to_entries[] | select(.value.remote==$r) | .key' "$REGISTRY" | head -1)
  if [ -z "$key" ]; then
    is_under_tmp "$path" && die "refusing to register '$path' as a new project — it's under the OS tmp dir ($TMPROOT), which looks like an ephemeral worktree/clone, not a permanent checkout. If it really is permanent, move it out of tmp first."
    key=$(basename "$path")
    echo "mmm: registering new project '$key' (remote $origin)"
    local tmp; tmp=$(mktemp)
    jq --arg k "$key" --arg r "$origin" --arg p "$path" \
      '.projects[$k] = {remote: $r, pathHint: $p}' "$REGISTRY" > "$tmp" && mv "$tmp" "$REGISTRY"
  else
    echo "mmm: '$key' already registered (remote $origin) — same project, this is another checkout/worktree of it, sharing its wiki"
  fi
  init_one "$key" "$path" "$path/.omc/wiki" "$MMM_HOME/projects/$key" 1 "$force_merge"
  # after init_one, not inside it: init_one's first_time/--merge logic keys off the store dir not existing yet
  link_claude_md "$key" "$path"
  link_claude_md "$key" "$path" AGENTS.md
  link_auto_memory "$key" "$path"
}

# --- rebalance ---------------------------------------------------------------
# the same move-into-store adoption `init` does (CLAUDE.md and auto memory), re-runnable across every registered project
cmd_rebalance() {
  need jq git
  echo "-- rebalance --"
  local k path
  for k in $(jq -r '.projects | keys[]' "$REGISTRY"); do
    if path=$(resolve_path "$k"); then
      link_claude_md "$k" "$path"
      link_claude_md "$k" "$path" AGENTS.md
      link_auto_memory "$k" "$path"
    else
      echo "  $k: absent on this machine (registered, not found)"
    fi
  done
}

# --- doctor ------------------------------------------------------------------
cmd_doctor() {
  need jq git rg
  local fail=0
  echo "== mmm doctor =="
  echo "-- secret scan --"
  if grep -rniE 'ticket=|token=|secret|password' "$MMM_HOME" \
      --include='*.json' --exclude-dir=.git 2>/dev/null | grep -v '^Binary'; then
    echo "FAIL: possible secrets found above"; fail=1
  else
    echo "PASS: no secret keywords in *.json"
  fi
  # the keyword grep above stays off *.md because prose *about* passwords tripped it; these are
  # the shapes real credentials take, which prose almost never does, so pages get scanned again
  if rg -n --no-heading --hidden --glob '*.md' --glob '*.json' --glob '!.git' -e "$SECRET_SHAPES" "$MMM_HOME" 2>/dev/null; then
    echo "FAIL: credential-shaped strings found above"; fail=1
  else
    echo "PASS: no credential-shaped strings in *.md/*.json"
  fi
  echo "-- git-ignore --"
  local k path
  for k in $(jq -r '.projects | keys[]' "$REGISTRY"); do
    if path=$(resolve_path "$k"); then
      if git -C "$path" check-ignore -q .omc; then
        echo "PASS: $k .omc is ignored"
      else
        echo "REPAIR: $k .omc not ignored, adding to $(git_exclude_path "$path")"
        if ensure_ignored "$path" .omc; then echo "PASS: $k now ignored"; else echo "FAIL: $k still not ignored"; fail=1; fi
      fi
    fi
  done
  echo "-- symlink health --"
  cmd_status
  [ "$STATUS_ISSUES" -gt 0 ] && fail=1
  echo "-- links / index / size / frontmatter / sources --"
  local paths='{}'
  for k in $(jq -r '.projects | keys[]' "$REGISTRY"); do
    path=$(resolve_path "$k") && paths=$(jq --arg k "$k" --arg p "$path" '.[$k] = $p' <<< "$paths")
  done
  MMM_PROJECT_PATHS="$paths" python3 "$MMM_BIN/mmm-doctor.py" "$MMM_HOME" || fail=1
  echo "-- claude/ subset plugins --"
  if [ -f "$MMM_HOME/claude/settings.json" ]; then
    local p val
    for p in ponytail caveman; do
      val=$(jq -r --arg p "$p" '.enabledPlugins // {} | to_entries[] | select(.key | startswith($p)) | .value' \
        "$MMM_HOME/claude/settings.json" 2>/dev/null | head -1)
      if [ "$val" = "true" ]; then echo "PASS: $p enabled"; else echo "WARN: $p not confirmed enabled"; fi
    done
  else
    echo "SKIP: no claude/settings.json staged yet"
  fi
  if [ "$fail" = 0 ]; then echo "mmm doctor: ALL CLEAR"; else echo "mmm doctor: ISSUES FOUND"; exit 1; fi
}

# --- pack / unpack -----------------------------------------------------------
cmd_pack() {
  need 7z jq git
  local projects="" out="" no_global=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) projects="$2"; shift 2 ;;
      --out) out="$2"; shift 2 ;;
      --no-global) no_global=1; shift ;;
      *) die "unknown pack option: $1" ;;
    esac
  done
  snapshot "mmm: before pack"
  cmd_rebalance  # before doctor, so a CLAUDE.md that slipped back into a repo is in the store when it is archived
  echo "mmm: running doctor before packing..."
  cmd_doctor  # full battery, not just secrets — its own "ISSUES FOUND" exits 1 and stops pack here
  [ -n "$out" ] || out="mmm-$(date +%Y%m%d).7z"
  # 7z runs from inside $MMM_HOME below, so a relative --out would land in the store itself
  # (and get swept into the next pack) instead of where the user ran the command
  case "$out" in /*) ;; *) out="$PWD/$out" ;; esac
  # bin/ lives in ~/mmm (the tool), not ~/.mmm (the data) — reinstall the tool separately
  local args=()
  [ "$no_global" = 1 ] || args+=(global)
  [ -d "$MMM_HOME/claude" ] && args+=(claude)

  # a --project archive that still shipped the FULL registry would leak every other project's
  # remote URL and local path -- defeating the point of restricting the archive at all. Build a
  # filtered copy in its own temp dir and add it as a single standalone file (named exactly
  # "registry.json", so it lands at the path unpack expects); the real file is never touched.
  local registry_src="$REGISTRY" registry_tmpdir=""
  if [ -n "$projects" ]; then
    IFS=',' read -ra keys <<< "$projects"
    local key
    for key in "${keys[@]}"; do
      [ -d "$MMM_HOME/projects/$key" ] || die "unknown/absent project: $key"
      args+=("projects/$key")
    done
    registry_tmpdir=$(mktemp -d)
    local keys_json
    keys_json=$(printf '%s\n' "${keys[@]}" | jq -R . | jq -s .)
    jq --argjson keys "$keys_json" \
      '.projects |= with_entries(select(.key as $k | $keys | index($k) != null))' \
      "$REGISTRY" > "$registry_tmpdir/registry.json"
    registry_src="$registry_tmpdir/registry.json"
  else
    [ -d "$MMM_HOME/projects" ] && args+=(projects)
  fi

  # -mhe=on (header encryption) is 7z-format-only; 7z rejects it with E_INVALIDARG for any
  # other archive type, so a .zip --out just drops it and relies on -p's own zip encryption.
  # -mem=AES256 is not a recognized switch on this p7zip build and made every `mmm pack` fail.
  local enc_args=(-p)
  case "$out" in *.7z|*.7Z) enc_args+=(-mhe=on) ;; esac
  ( cd "$MMM_HOME" && 7z a -mx=9 "${enc_args[@]}" "$out" "$registry_src" "${args[@]}" )
  [ -n "$registry_tmpdir" ] && rm -rf "$registry_tmpdir"
  echo "mmm: wrote $out"
}

cmd_unpack() {
  need 7z
  local archive="$1" into="${MMM_HOME}"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in --into) into="$2"; shift 2 ;; *) die "unknown unpack option: $1" ;; esac
  done
  mkdir -p "$into"
  [ "$into" = "$MMM_HOME" ] && snapshot "mmm: before unpack $(basename "$archive")"
  7z x "$archive" -o"$into"
  echo "mmm: unpacked into $into — now run 'mmm init <path>' for each project present on this machine"
  if [ "$into" = "$MMM_HOME" ] && [ -n "$(store_git status --porcelain)" ]; then
    echo "mmm: the archive changed these files (review with 'mmm git diff', undo one with 'mmm git checkout -- <file>'):"
    store_git status --short
  fi
}

# --- query / ask ---------------------------------------------------------
cmd_query() { need rg; python3 "$MMM_BIN/mmm-query.py" "$MMM_HOME" "$@"; }
cmd_links() { python3 "$MMM_BIN/mmm-links.py" "$MMM_HOME" "$@"; }

# the tier a command run from here should write to: this checkout's project, else global
current_tier() {
  local origin key
  origin=$(git remote get-url origin 2>/dev/null) || { echo "$MMM_HOME/global"; return; }
  key=$(jq -r --arg r "$origin" '.projects | to_entries[] | select(.value.remote==$r) | .key' "$REGISTRY" | head -1)
  if [ -n "$key" ]; then echo "$MMM_HOME/projects/$key"; else echo "$MMM_HOME/global"; fi
}

cmd_ask() {
  need rg claude
  local save=0
  [ "${1:-}" = "--save" ] && { save=1; shift; need jq git; }
  local q="$*" pattern
  # a question isn't a literal search term — reduce to keywords (rg alternation) before searching;
  # `mmm query` itself stays literal, this reduction is ask-only
  pattern=$(python3 -c "
import re, sys
stop = set('a an the is are was were be been being of to for in on at by with from as it its '
           'this that what which who whom how do does did can could would should will shall '
           'not no yes i you your my me we they he she and or if but'.split())
words = re.findall(r'[A-Za-z0-9_]+', sys.argv[1].lower())
kw = [w for w in words if w not in stop and len(w) > 2]
print('|'.join(dict.fromkeys(kw)) if kw else sys.argv[1])
" "$q")
  local hits
  hits=$(python3 "$MMM_BIN/mmm-query.py" "$MMM_HOME" --json "$pattern") || die "mmm query found nothing relevant to: $q"
  local answer
  answer=$(printf '%s\n' "$hits" | claude -p "Given ONLY these wiki excerpts (JSON), answer concisely: $q
Cite the page filename(s) you used. If the excerpts don't answer it, say so.")
  printf '%s\n' "$answer"
  [ "$save" = 1 ] || return 0
  # log.md, not a new page: an answer is a synthesis worth keeping, but deciding where it belongs
  # is placement judgment -- that's for the agent or 'mmm import', not a one-shot call
  local log; log="$(current_tier)/log.md"
  mkdir -p "$(dirname "$log")"
  printf '\n## [%s] ask | %s\n\n%s\n' "$(date +%Y-%m-%d)" "$q" "$answer" >> "$log"
  echo "mmm: saved to $log"
}

# --- import ------------------------------------------------------------------
cmd_import() {
  need claude
  local src="$1"
  [ -e "$src" ] || die "not found: $src"
  src=$(cd "$(dirname "$src")" && pwd)/$(basename "$src")
  local rules="$MMM_BIN/../content-rules.md"
  [ -f "$rules" ] || die "content-rules.md missing at $rules — mmm install is incomplete"
  exec claude "Import $src into the mmm wiki (canonical store: \$MMM_HOME=$MMM_HOME; global/ and
projects/<key>/ are its two tiers, each symlinked from ~/.omc/wiki or a project's own .omc/wiki).

Read $rules for the content rules (page format, placement rule, size budget, tasks.md
convention) before doing anything else.

Read $src, decide the right destination(s) under $MMM_HOME — global and/or whichever project(s)
this content is actually about (not necessarily just the one I'm standing in). If it covers more
than one topic or project, split it across multiple pages/destinations rather than forcing one.
Normalize into properly-formatted pages with YAML frontmatter, update the relevant index.md
file(s), then run 'mmm doctor' and fix anything it flags before you're done."
}

# --- tidy ------------------------------------------------------------------
# what Auto Dream / Letta's sleep-time agent do between sessions, but on request: import adds
# knowledge, tidy is the matching pass that consolidates what accumulated
cmd_tidy() {
  need claude jq git
  local tier
  case "${1:-}" in
    --global) tier="$MMM_HOME/global" ;;
    --project) [ -d "$MMM_HOME/projects/${2:-}" ] || die "unknown project: ${2:-}"; tier="$MMM_HOME/projects/$2" ;;
    "") tier=$(current_tier) ;;
    *) die "usage: mmm tidy [--global | --project <key>]" ;;
  esac
  local rules="$MMM_BIN/../content-rules.md"
  [ -f "$rules" ] || die "content-rules.md missing at $rules — mmm install is incomplete"
  snapshot "mmm: before tidy $(basename "$tier")"
  exec claude "Tidy the mmm wiki tier at $tier (canonical store \$MMM_HOME=$MMM_HOME). Read $rules first.

Consolidate, don't expand:
- merge pages that cover the same topic; keep the better slug, fix every [[link]] to the other
- where two pages contradict, find which is current (check the code or git log when a page has
  sources:) and fix or delete the stale claim; mark reversed decisions with superseded_by
- turn relative dates ('yesterday', 'last week') into absolute ones
- drop notes that are only true for a finished task, or that the code/CLAUDE.md already says
- fold $tier/log.md entries worth keeping into the page they belong to
- keep index.md one line per page and in sync with what exists; bump updated on pages you change
Leave memory/ (Claude Code's own auto memory) alone. The store is snapshotted in git; list what
you changed at the end ('mmm git diff' shows it). Then run 'mmm doctor' and fix what it flags."
}

# --- dispatch ----------------------------------------------------------------
usage() {
  cat <<'EOF'
mmm — canonical wiki store + symlink adoption + query
usage:
  mmm status                         link-health check (default)
  mmm init <path> | --global [--merge]   one-time: move+link a project's/global wiki into ~/.mmm
                                      (a worktree/second clone of an already-initialized remote
                                       shares that project's wiki; --merge only if it grew its own)
  mmm doctor                         full health check (links, index, secrets, git-ignore)
  mmm rebalance                      move each project's CLAUDE.md and Claude Code auto memory into the
                                      store, leave symlinks behind (runs automatically before pack)
  mmm forget <key>                   drop a registered project (fixes a stale/absent entry)
  mmm pack [--project k1,k2] [--out f] [--no-global]   encrypted archive of ~/.mmm
  mmm unpack <archive> [--into dir]  extract an archive
  mmm query|q "<term>" [--project k] [--global-only] [--json]   instant, no LLM
  mmm ask|a [--save] "<question>"    one cheap claude -p call, scoped to query's hits
                                      (--save appends the answer to this tier's log.md)
  mmm links <slug> | --orphans       backlinks/outlinks of a page, or pages nothing links to
  mmm import <file-or-folder>        interactive claude session: read, place, normalize into pages
  mmm tidy [--global|--project k]    interactive claude session: merge duplicates, drop stale facts
  mmm git <args>                     git inside ~/.mmm (log, diff, checkout) — snapshotted at every
                                      session start, before pack and before unpack
EOF
}

if [ $# -eq 0 ]; then
  usage
  echo
  echo "status:"
  cmd_status
  exit 0
fi

cmd="$1"; shift
case "$cmd" in
  status) cmd_status ;;
  init) [ $# -ge 1 ] || die "usage: mmm init <path>|--global [--merge]"; cmd_init "$@" ;;
  doctor) cmd_doctor ;;
  rebalance) cmd_rebalance ;;
  forget) [ $# -ge 1 ] || die "usage: mmm forget <key>"; cmd_forget "$@" ;;
  pack) cmd_pack "$@" ;;
  unpack) [ $# -ge 1 ] || die "usage: mmm unpack <archive>"; cmd_unpack "$@" ;;
  query|q) cmd_query "$@" ;;
  ask|a) cmd_ask "$@" ;;
  links) cmd_links "$@" ;;
  tidy) cmd_tidy "$@" ;;
  import) [ $# -ge 1 ] || die "usage: mmm import <file-or-folder>"; cmd_import "$@" ;;
  git) need git; store_git "$@" ;;
  -h|--help|help) usage ;;
  *) usage; die "unknown command: $cmd" ;;
esac
